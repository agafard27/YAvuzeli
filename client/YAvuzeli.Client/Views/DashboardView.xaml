<UserControl x:Class="YAvuzeli.Client.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="Auto" Width="Auto">
    <Grid>
        <StackPanel>
            <TextBlock Text="Dashboard" FontSize="20" FontWeight="Bold" Margin="6" />
            <WrapPanel Margin="6">
                <Border Background="#FFFBCC" Padding="12" Margin="6">
                    <StackPanel>
                        <TextBlock Text="Gelir" FontWeight="Bold"/>
                        <TextBlock Text="₺0" FontSize="16"/>
                    </StackPanel>
                </Border>
                <Border Background="#CCFFCC" Padding="12" Margin="6">
                    <StackPanel>
                        <TextBlock Text="Yoklama" FontWeight="Bold"/>
                        <TextBlock Text="%0" FontSize="16"/>
                    </StackPanel>
                </Border>
            </WrapPanel>
            <TextBlock Margin="6" Text="Hızlı Erişim" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</UserControl>
