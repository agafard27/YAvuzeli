<UserControl x:Class="YAvuzeli.Client.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Language="tr-TR" FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="White" CornerRadius="8" BorderBrush="#DDE5EF" BorderThickness="1" Padding="18">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Button Content="CSV dışa aktar" Command="{Binding ExportCsvCommand}" HorizontalAlignment="Right" Padding="13,8" Margin="0,0,0,14"/>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Lines}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeight="42" AlternatingRowBackground="#F8FAFC">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Rapor" Binding="{Binding Title}" Width="220"/>
                        <DataGridTextColumn Header="Değer" Binding="{Binding Value}" Width="160"/>
                        <DataGridTextColumn Header="Açıklama" Binding="{Binding Detail}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,14,0,0">
            <TextBlock Text="{Binding Message}" Foreground="#8A351B"/>
        </Border>
    </Grid>
</UserControl>
