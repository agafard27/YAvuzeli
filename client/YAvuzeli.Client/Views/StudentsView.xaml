<UserControl x:Class="YAvuzeli.Client.Views.StudentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Language="tr-TR"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <SolidColorBrush x:Key="TextMainBrush" Color="#18243A"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="LineBrush" Color="#DDE5EF"/>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="Margin" Value="0,5,0,13"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#26364F"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#225CB5"/>
            <Setter Property="BorderBrush" Value="#225CB5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="White" CornerRadius="8" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="18">
                <StackPanel>
                    <TextBlock Text="Toplam öğrenci" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding TotalStudentsText}" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource TextMainBrush}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="8" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="18">
                <StackPanel>
                    <TextBlock Text="Aktif öğrenci" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding ActiveStudentsText}" FontSize="30" FontWeight="SemiBold" Foreground="#166534" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Background="White" CornerRadius="8" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="18">
                <StackPanel>
                    <TextBlock Text="Pasif öğrenci" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding InactiveStudentsText}" FontSize="30" FontWeight="SemiBold" Foreground="#92400E" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="22"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <Border Background="White" CornerRadius="8" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Öğrenci listesi" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextMainBrush}"/>
                            <TextBlock Text="{Binding SelectedStudentText}" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding CountText}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,18,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Öğrenci ara"
                                 ToolTip="Ad, soyad, telefon veya e-posta ile ara"
                                 Margin="0,0,14,0"/>
                        <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button Content="Yenile" Command="{Binding RefreshCommand}"/>
                            <Button Content="Düzenle" Command="{Binding EditCommand}"/>
                            <Button Content="Sil" Command="{Binding DeleteCommand}" Foreground="#B42318"/>
                        </WrapPanel>
                    </Grid>

                    <DataGrid Grid.Row="2" ItemsSource="{Binding Students}" SelectedItem="{Binding SelectedStudent}"
                              IsEnabled="{Binding IsReady}" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow"
                              HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="Horizontal"
                              BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                              AlternatingRowBackground="#F8FAFC" RowHeight="36"
                              FontSize="13">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ad" Binding="{Binding FirstName}" Width="*"/>
                            <DataGridTextColumn Header="Soyad" Binding="{Binding LastName}" Width="*"/>
                            <DataGridTextColumn Header="Telefon" Binding="{Binding Phone}" Width="125"/>
                            <DataGridTextColumn Header="E-posta" Binding="{Binding Email}" Width="180"/>
                            <DataGridCheckBoxColumn Header="Aktif" Binding="{Binding IsActive}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="3" Text="{Binding StorageText}" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,12,0,0"/>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="8" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel IsEnabled="{Binding IsReady}">
                        <TextBlock Text="{Binding EditorTitle}" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource TextMainBrush}"/>
                        <TextBlock Text="Zorunlu alanlar yıldız ile işaretlidir." Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,18"/>

                        <TextBlock Text="Ad *" Foreground="{StaticResource TextMainBrush}"/>
                        <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" AutomationProperties.Name="Ad"/>

                        <TextBlock Text="Soyad *" Foreground="{StaticResource TextMainBrush}"/>
                        <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" AutomationProperties.Name="Soyad"/>

                        <TextBlock Text="Doğum tarihi *" Foreground="{StaticResource TextMainBrush}"/>
                        <DatePicker SelectedDate="{Binding BirthDate}" SelectedDateFormat="Short" Margin="0,5,0,13" AutomationProperties.Name="Doğum tarihi"/>

                        <TextBlock Text="Telefon" Foreground="{StaticResource TextMainBrush}"/>
                        <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" MaxLength="30" AutomationProperties.Name="Telefon"/>

                        <TextBlock Text="E-posta" Foreground="{StaticResource TextMainBrush}"/>
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" AutomationProperties.Name="E-posta"/>

                        <CheckBox Content="Aktif öğrenci" IsChecked="{Binding IsActive}" Margin="0,2,0,20"/>

                        <Button Content="{Binding SaveLabel}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,9"/>
                        <Button Content="Yeni öğrenci / Formu temizle" Command="{Binding NewCommand}" Margin="0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,14,0,0">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#8A351B" AutomationProperties.LiveSetting="Polite"/>
        </Border>
    </Grid>
</UserControl>
