<UserControl x:Class="YAvuzeli.Client.Views.ScheduleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Language="tr-TR" FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <Border Background="White" CornerRadius="8" BorderBrush="#DDE5EF" BorderThickness="1" Padding="18">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Ders kayıtları" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,14"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Enrollments}" SelectedItem="{Binding SelectedEnrollment}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" RowHeight="34" AlternatingRowBackground="#F8FAFC">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Öğrenci" Binding="{Binding StudentName}" Width="*"/>
                            <DataGridTextColumn Header="Ders" Binding="{Binding CourseTitle}" Width="*"/>
                            <DataGridTextColumn Header="Tarih" Binding="{Binding EnrollmentDate, StringFormat=d}" Width="95"/>
                            <DataGridTextColumn Header="Ücret" Binding="{Binding Fee, StringFormat=N2}" Width="85"/>
                            <DataGridCheckBoxColumn Header="Ödendi" Binding="{Binding IsPaid}" Width="65"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Margin="0,14,0,0">
                        <UniformGrid Columns="2">
                            <ComboBox ItemsSource="{Binding Students}" SelectedValue="{Binding EnrollmentStudentId}" SelectedValuePath="Id" DisplayMemberPath="Name" Margin="0,0,8,8"/>
                            <ComboBox ItemsSource="{Binding Courses}" SelectedValue="{Binding EnrollmentCourseId}" SelectedValuePath="Id" DisplayMemberPath="Name" Margin="8,0,0,8"/>
                            <DatePicker SelectedDate="{Binding EnrollmentDate}" Margin="0,0,8,8"/>
                            <TextBox Text="{Binding Fee, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,8" Padding="7" ToolTip="Ücret"/>
                        </UniformGrid>
                        <CheckBox Content="Ücreti ödendi" IsChecked="{Binding IsPaid}" Margin="0,0,0,10"/>
                        <WrapPanel>
                            <Button Content="{Binding EnrollmentSaveLabel}" Command="{Binding SaveEnrollmentCommand}" Background="#225CB5" Foreground="White" Padding="12,8" Margin="0,0,8,0"/>
                            <Button Content="Düzenle" Command="{Binding EditEnrollmentCommand}" Padding="12,8" Margin="0,0,8,0"/>
                            <Button Content="Yeni" Command="{Binding NewEnrollmentCommand}" Padding="12,8" Margin="0,0,8,0"/>
                            <Button Content="Sil" Command="{Binding DeleteEnrollmentCommand}" Padding="12,8" Foreground="#B42318"/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="8" BorderBrush="#DDE5EF" BorderThickness="1" Padding="18">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Haftalık program" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,14"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Schedule}" SelectedItem="{Binding SelectedSchedule}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" RowHeight="34" AlternatingRowBackground="#F8FAFC">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Gün" Binding="{Binding DayName}" Width="95"/>
                            <DataGridTextColumn Header="Ders" Binding="{Binding CourseTitle}" Width="*"/>
                            <DataGridTextColumn Header="Başlangıç" Binding="{Binding StartTime}" Width="80"/>
                            <DataGridTextColumn Header="Bitiş" Binding="{Binding EndTime}" Width="80"/>
                            <DataGridTextColumn Header="Sınıf" Binding="{Binding Room}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Margin="0,14,0,0">
                        <ComboBox ItemsSource="{Binding Courses}" SelectedValue="{Binding ScheduleCourseId}" SelectedValuePath="Id" DisplayMemberPath="Name" Margin="0,0,0,8"/>
                        <UniformGrid Columns="4">
                            <ComboBox ItemsSource="{Binding Days}" SelectedValue="{Binding ScheduleDay}" SelectedValuePath="Id" DisplayMemberPath="Name" Margin="0,0,8,8"/>
                            <TextBox Text="{Binding StartTime, UpdateSourceTrigger=PropertyChanged}" Padding="7" Margin="8,0,8,8" ToolTip="Başlangıç"/>
                            <TextBox Text="{Binding EndTime, UpdateSourceTrigger=PropertyChanged}" Padding="7" Margin="8,0,8,8" ToolTip="Bitiş"/>
                            <TextBox Text="{Binding Room, UpdateSourceTrigger=PropertyChanged}" Padding="7" Margin="8,0,0,8" ToolTip="Sınıf"/>
                        </UniformGrid>
                        <WrapPanel>
                            <Button Content="{Binding ScheduleSaveLabel}" Command="{Binding SaveScheduleCommand}" Background="#225CB5" Foreground="White" Padding="12,8" Margin="0,0,8,0"/>
                            <Button Content="Düzenle" Command="{Binding EditScheduleCommand}" Padding="12,8" Margin="0,0,8,0"/>
                            <Button Content="Yeni" Command="{Binding NewScheduleCommand}" Padding="12,8" Margin="0,0,8,0"/>
                            <Button Content="Sil" Command="{Binding DeleteScheduleCommand}" Padding="12,8" Foreground="#B42318"/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="1" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,14,0,0">
            <TextBlock Text="{Binding Message}" Foreground="#8A351B"/>
        </Border>
    </Grid>
</UserControl>
