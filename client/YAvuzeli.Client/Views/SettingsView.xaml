<UserControl x:Class="YAvuzeli.Client.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Language="tr-TR" FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="White" CornerRadius="8" BorderBrush="#DDE5EF" BorderThickness="1" Padding="22">
            <StackPanel>
                <TextBlock Text="Ayarlar ve yedekleme" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="Veriler bu bilgisayardaki yerel SQLite dosyasında saklanır." Foreground="#64748B" Margin="0,8,0,18"/>
                <TextBlock Text="Veri dosyası" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding DatabasePath}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,6,0,22"/>
                <WrapPanel>
                    <Button Content="Yedek al" Command="{Binding BackupCommand}" Background="#225CB5" Foreground="White" Padding="14,9" Margin="0,0,10,0"/>
                    <Button Content="Yedekten geri yükle" Command="{Binding RestoreCommand}" Padding="14,9"/>
                </WrapPanel>
                <TextBlock Text="Yedekler Belgeler\YAvuzeli-Yedekler klasörüne kaydedilir." Foreground="#64748B" Margin="0,18,0,0"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,14,0,0">
            <TextBlock Text="{Binding Message}" Foreground="#8A351B" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>
